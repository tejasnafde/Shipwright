# Template only. Copy to .env and fill in values; .env is git-ignored.
# The scripts read the HF token from $SWITCHBOARD_SECRETS_DIR/HF_TOKEN first, then $HF_TOKEN.
HF_TOKEN=

# Optional: also send run spans to an OTel backend (docs/observability.md).
# Leave empty to write only runs/<dir>/otel_spans.jsonl.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Vertex AI models (vertex/<publisher>/<model> ids; docs/baseline.md, "Vertex AI models").
# The token comes from gcloud with this config, never from Application Default Credentials.
# Tejas: personal. Ishank and Mitushi: lexsi.
SHIPWRIGHT_GCLOUD_CONFIG=personal
SHIPWRIGHT_GCP_PROJECT=lexsi-hackathon
